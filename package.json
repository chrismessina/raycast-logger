{
  "name": "@chrismessina/raycast-logger",
  "version": "1.4.0",
  "description": "A secure, preference-driven logger for Raycast extensions with automatic redaction of sensitive data",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "raycast",
    "logger",
    "logging",
    "security",
    "redaction",
    "privacy"
  ],
  "author": "Chris Messina",
  "license": "MIT",
  "peerDependencies": {
    "@raycast/api": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@raycast/api": "^2.0.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrismessina/raycast-logger.git"
  },
  "bugs": {
    "url": "https://github.com/chrismessina/raycast-logger/issues"
  },
  "homepage": "https://github.com/chrismessina/raycast-logger#readme"
}
